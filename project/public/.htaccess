# Bật "công cụ viết lại" URL
RewriteEngine On

# Đặt "thư mục gốc" mà .htaccess này đang hoạt động
# Rất QUAN TRỌNG: Nó phải khớp với đường dẫn thư mục 'public' của bạn
RewriteBase /du-an-1-book-store/project/public/

# ĐIỀU KIỆN:
# Nếu request KHÔNG PHẢI là một file có thật (như .css, .jpg)
RewriteCond %{REQUEST_FILENAME} !-f
# VÀ nếu request KHÔNG PHẢI là một thư mục có thật
RewriteCond %{REQUEST_FILENAME} !-d

# QUY TẮC:
# Chuyển hướng TẤT CẢ các request khác đến index.php
# và "nhét" URL gốc vào biến 'url'
# ^(.*)$ "bắt" lấy mọi thứ (ví dụ: "login/abc")
# index.php?url=$1 chuyển nó thành index.php?url=login/abc
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]